# ======================================================
# BEM ITM - Konfigurasi HTTP & Keamanan (InfinityFree)
# ======================================================

Options -Indexes
AddDefaultCharset UTF-8

# Proteksi file sensitif
<FilesMatch "^(config\.php|database\.sql|README\.md|\.env|\.gitignore)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Blokir dotfiles
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.git(/|$) - [F,L]
    # Blokir path traversal
    RewriteCond %{QUERY_STRING} (\.\.\/|\.\.\\) [NC,OR]
    RewriteCond %{REQUEST_URI} (\.\.\/|\.\.\\) [NC]
    RewriteRule .* - [F,L]
    # Blokir SQL injection
    RewriteCond %{QUERY_STRING} (union.*select|insert.*into|delete.*from|drop.*table|update.*set) [NC]
    RewriteRule .* - [F,L]
    # Blokir attack paths
    RewriteRule ^(wp-admin|wp-login|xmlrpc\.php|\.env|\.git) - [F,L,NC]
</IfModule>

# Security headers (ringan, compatible shared hosting)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Kompresi
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
</IfModule>

# Cache
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
</IfModule>
