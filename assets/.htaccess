# ======================================================
# BEM ITM — Proteksi Area Aset (induk img/ & uploads/)
# ======================================================

Options -Indexes

# Nonaktifkan eksekusi PHP & skrip lain di seluruh area aset
<IfModule php_module>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .pht .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl .py .sh .asp .aspx
RemoveType .php .phtml .pht .phar

<FilesMatch "\.(php\d*|phtml|pht|phar|cgi|pl|py|sh|asp|aspx)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>