# ======================================================
# BEM ITM - Proteksi Area Admin (InfinityFree)
# ======================================================
Options -Indexes

# Tolak akses langsung ke folder includes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^includes(/|$) - [F,L,NC]
    RewriteRule ^(auth\.php|\.env|config\.php|.*\.sql|.*\.log|.*\.bak)$ - [F,L,NC]
</IfModule>

# Blokir dotfiles
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Blokir bot & serangan
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_USER_AGENT} (sqlmap|nikto|nessus|dirbuster|gobuster) [NC]
    RewriteRule .* - [F,L]
    RewriteCond %{QUERY_STRING} (\.\.\/|\.\.\\) [NC]
    RewriteRule .* - [F,L]
    RewriteRule ^(phpmyadmin|phpMyAdmin|myadmin|mysql|dbadmin) - [F,L,NC]
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
